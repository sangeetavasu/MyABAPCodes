*&---------------------------------------------------------------------*
FORM get_data .
**NTT ATC CCR CHANGES - [Date: 2025-10-13] - [Developer/10138580]
*  DATA: lt_mdkp  TYPE TABLE OF mdkp,          "#EC CI_USAGE_OK[2268085]
*        ls_mdkp  TYPE mdkp,                   "#EC CI_USAGE_OK[2268085]
  DATA: lt_mdkp  TYPE TABLE OF mdma,          "#EC CI_USAGE_OK[2268085]
        ls_mdkp  TYPE mdma,
*  - Added pseudo comment to suppress non-critical ATC warning
        lt_mdpsx TYPE TABLE OF mdps,
        ls_mdpsx TYPE mdps.
  DATA: lt_t458a TYPE TABLE OF t458a,
        ls_t458a TYPE t458a,
        lt_t458b TYPE TABLE OF t458b,
        ls_t458b TYPE t458b.
  DATA: lt_lfa1 TYPE TABLE OF lfa1,
        ls_lfa1 TYPE lfa1.

  DATA: lt_ekes TYPE TABLE OF ekes,
        ls_ekes TYPE ekes.

  DATA: lv_maktx  TYPE makt-maktx.
  DATA: tb_t024d TYPE TABLE OF t024d,
        wa_t024d LIKE LINE OF tb_t024d.

  REFRESH lt_lfa1.
  SELECT lifnr name1 FROM lfa1
    INTO CORRESPONDING FIELDS OF TABLE lt_lfa1.
  SORT lt_lfa1 BY lifnr.
**NTT ATC CCR CHANGES - [Date: 2025-10-13] - [Developer/10138580]
*Begin of comment by US5092 03/24/2026 9004233540 - Custom Query ZMD04 Issue
*  SELECT matnr plwrk dispo             "#EC CI_DB_OPERATION_OK[2268085]
*    INTO CORRESPONDING FIELDS OF TABLE lt_mdkp
*    FROM mdkp
*    WHERE mdkp~mtart IN s_mtart
*      AND mdkp~matnr IN s_matnr
*      AND mdkp~beskz IN s_beskz
*      AND mdkp~dispo IN s_dispo
*      AND mdkp~dispo IN s_dismm.              "#EC CI_USAGE_OK[2268085]
*End of comment by US5092 03/24/2026 9004233540 - Custom Query ZMD04 Issue

*Begin of changes by US5092 03/24/2026 9004233540 - Custom Query ZMD04 Issue
*MRP Area table to be used instead after S4

  SELECT marc~matnr marc~werks marc~dispo "#EC CI_DB_OPERATION_OK[2268085]
   INTO CORRESPONDING FIELDS OF TABLE lt_mdkp
   FROM marc
    INNER JOIN mara ON mara~matnr = marc~matnr
   WHERE mara~matnr IN s_matnr
   AND mara~mtart IN s_mtart
   AND marc~werks IN s_werks
   AND marc~dispo IN s_dispo
   AND marc~dismm IN s_dismm
   AND marc~beskz IN s_beskz.
*End of changes by US5092 03/24/2026 9004233540 - Custom Query ZMD04 Issue


*  - Added pseudo comment to suppress non-critical ATC warning
  SORT lt_mdkp BY matnr werks.
*  DELETE ADJACENT DUPLICATES FROM lt_mdkp
*  COMPARING matnr plwrk.
  DELETE ADJACENT DUPLICATES FROM lt_mdkp
 COMPARING matnr werks.

  SELECT * FROM t458a
    INTO CORRESPONDING FIELDS OF TABLE lt_t458a.
  SORT lt_t458a BY aussl.

  SELECT * FROM t458b
    INTO CORRESPONDING FIELDS OF TABLE lt_t458b
    WHERE spras = sy-langu ORDER BY PRIMARY KEY.
  SORT lt_t458a BY aussl.

*Begin of changes 9003040288 - Modify custom Query ZMD04
*Obtain the various descriptions for MRP controller.
  SELECT dispo dsnam FROM t024d
  INTO CORRESPONDING FIELDS OF TABLE tb_t024d.
*End of changes 9003040288 - Modify custom Query ZMD04

  LOOP AT lt_mdkp INTO ls_mdkp.

    REFRESH lt_mdpsx.
**NTT ATC CCR CHANGES - [Date: 2025-10-13] - [Developer/10138580]
    CALL FUNCTION 'MD_STOCK_REQUIREMENTS_LIST_API'
    "#EC CI_USAGE_OK[2268085]
    "#EC CI_USAGE_OK[3211383]
    "#EC CI_USAGE_OK[2227532]
    "#EC CI_USAGE_OK[2227579]
*  - Added pseudo comment to suppress non-critical ATC warning
      EXPORTING
        matnr                    = ls_mdkp-matnr
        werks                    = ls_mdkp-werks
      TABLES
        mdpsx                    = lt_mdpsx
      EXCEPTIONS
        material_plant_not_found = 1
        plant_not_found          = 2
        OTHERS                   = 3.
    IF sy-subrc <> 0.
    ENDIF.

    IF NOT s_lifnr[] IS INITIAL.
      DELETE lt_mdpsx WHERE NOT lifnr IN s_lifnr[].
      CHECK NOT lt_mdpsx IS INITIAL.
    ENDIF.

    CLEAR lv_maktx.
    SELECT SINGLE maktx INTO lv_maktx
      FROM makt
      WHERE matnr = ls_mdkp-matnr
        AND spras = sy-langu.

    LOOP AT lt_mdpsx INTO ls_mdpsx.
      CLEAR gs_out.

      CHECK ls_mdpsx-mng01 > 0.
      CHECK ls_mdpsx-plumi = '+'.
      CHECK ( ls_mdpsx-delkz = 'BE' OR ls_mdpsx-delkz = 'LA' ) .

      CLEAR ls_t458a.
      READ TABLE lt_t458a INTO ls_t458a
        WITH KEY aussl = ls_mdpsx-aussl
        BINARY SEARCH.

      CHECK ls_t458a-selgp IN s_selgp[].
      CHECK ls_t458a-auskt IN s_auskt[].


      gs_out-matnr = ls_mdkp-matnr.
      gs_out-werks = ls_mdkp-werks.
      gs_out-maktx = lv_maktx.
*      gs_out-plwrk = ls_mdkp-plwrk.
      gs_out-lifnr = ls_mdpsx-lifnr.
*Begin of changes 9003040288 - Modify custom Query ZMD04
      READ TABLE tb_t024d INTO wa_t024d WITH KEY dispo = ls_mdkp-dispo.
      IF sy-subrc = 0.
        gs_out-dsnam = wa_t024d-dsnam.
      ENDIF.
*End of changes 9003040288 - Modify custom Query ZMD04
      CLEAR ls_lfa1.
      READ TABLE lt_lfa1 INTO ls_lfa1
        WITH KEY lifnr = gs_out-lifnr
        BINARY SEARCH .
      gs_out-name1 = ls_lfa1-name1.

      IF ls_mdpsx-delkz = 'LA'.
*        SELECT SINGLE menge INTO gs_out-etmen
*          FROM ekpo
*          WHERE ebeln = ls_mdpsx-delnr
*            AND ebelp = ls_mdpsx-delps.
        REFRESH lt_ekes.
        SELECT menge
          INTO CORRESPONDING FIELDS OF TABLE lt_ekes
          FROM ekes
          WHERE ebeln = ls_mdpsx-delnr
            AND ebelp = ls_mdpsx-delps
            AND etens = ls_mdpsx-delet.
        LOOP AT lt_ekes INTO ls_ekes.
          gs_out-etmen = gs_out-etmen + ls_ekes-menge.
        ENDLOOP.
      ELSE.
        gs_out-etmen = ls_mdpsx-etmen.
      ENDIF.

      gs_out-mng01 = ls_mdpsx-mng01.
*      IF ls_mdpsx-delkz = 'BE'.
      gs_out-qtrec = gs_out-etmen - ls_mdpsx-mng01.
*      ENDIF.
      gs_out-dat01 = ls_mdpsx-dat01.
      gs_out-dat00 = ls_mdpsx-dat00.
      gs_out-delnr = ls_mdpsx-delnr.
      gs_out-delps = ls_mdpsx-delps.
      gs_out-umdat = ls_mdpsx-umdat.
      gs_out-auskt = ls_t458a-auskt.

      CLEAR ls_t458b.
      READ TABLE lt_t458b INTO ls_t458b "#EC CI_SORTED " Added by NDBS during Code Remediation
        WITH KEY aussl = ls_mdpsx-aussl
        BINARY SEARCH.
      gs_out-auslt = ls_t458b-auslt.

      APPEND gs_out TO gt_out.
    ENDLOOP.

*    IF sy-subrc <> 0.
*      CLEAR gs_out.
*      gs_out-matnr = ls_mdkp-matnr.
*      gs_out-maktx = lv_maktx.
**      gs_out-plwrk = ls_mdkp-plwrk.
*      APPEND gs_out TO gt_out.
*    ENDIF.

  ENDLOOP.

ENDFORM.                    " get_data


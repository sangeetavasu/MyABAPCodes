FORM display .

  DATA: lv_repid  TYPE sy-repid.

  DATA: lt_fcat TYPE slis_t_fieldcat_alv,
        ls_fcat TYPE LINE OF slis_t_fieldcat_alv,
        ls_layo TYPE slis_layout_alv.

  DEFINE fill_fieldcat.
    ls_fcat-fieldname     = &1.
    ls_fcat-tabname       = 'GT_OUT'.
    IF  NOT &4 IS INITIAL.
      ls_fcat-seltext_s = &4.
      ls_fcat-seltext_l = &4.
      ls_fcat-seltext_m = &4.
    ELSE.
      ls_fcat-ref_tabname   = &2.
      ls_fcat-ref_fieldname = &3.
    ENDIF.
    IF NOT &5 IS INITIAL.
      ls_fcat-outputlen = &5.
    ENDIF.
    APPEND ls_fcat TO lt_fcat.
    CLEAR ls_fcat.
  END-OF-DEFINITION.


  fill_fieldcat   'MATNR'   'MDKP'    'MATNR'   'Material Number'                 20.
    fill_fieldcat   'WERKS'   'MDKP'    'WERKS'   'Plant'                 10.
*  fill_fieldcat   'PLWRK'   'MDKP'    'PLWRK'   'Plant'                           5.
  fill_fieldcat   'MAKTX'   'MAKT'    'MAKTX'   'Material Description'            35.
  fill_fieldcat   'DSNAM'   'T024D'    'DSNAM'   'MRP Controller'               20. "+US5092 9003040288 - Modify custom Query ZMD04
  fill_fieldcat   'AUSKT'   'T458A'   'AUSKT'   'Exception Message Code'          10.
  fill_fieldcat   'AUSLT'   'T458B'   'AUSLT'   'Exception Message Description'   35.
  fill_fieldcat   'LIFNR'   'MDPS'    'LIFNR'   'Vendor Number'                   11 .
  fill_fieldcat   'NAME1'   'LFA1'    'NAME1'   'Vendor Name'                     15 .
  fill_fieldcat   'DELNR'   'MDPS'    'DELNR'   'Purchase Order'                  15.
  fill_fieldcat   'DELPS'   'MDPS'    'DELPS'   'Line Item'                       15.
  fill_fieldcat   'ETMEN'   'MDPS'    'ETMEN'   'Order Quantity'                  15.
  fill_fieldcat   'MNG01'   'MDPS'    'MNG01'   'Qty Remaining'                   15.
  fill_fieldcat   'QTREC'   'MDPS'    'ETMEN'   'Qty Received'                    15.
  fill_fieldcat   'DAT01'   'MDPS'    'DAT01'   'Delivery Date'                   13.
  fill_fieldcat   'DAT00'   'MDPS'    'DAT00'   'Purchasing Date'                 15.
  fill_fieldcat   'UMDAT'   'MDPS'    'UMDAT'   'Rescheduling Date'               20.
*begin of changes 9003040288 - Modify custom Query ZMD04

  fill_fieldcat   'AUFNR'   'AFPO'    'AUFNR'   'Production Order'               20.
  fill_fieldcat   'PSMNG'   'AFPO'    'PSMNG'   'Production Order Quantity'               20.
  fill_fieldcat   'WEMNG'   'MDPS'    'WEMNG'   'Prod order delivered'               20.
  fill_fieldcat   'REMQTY'   'MDPS'    'WEMNG'   'ProdOrd Remaining Qt'               20.
*End of changes 9003040288 - Modify custom Query ZMD04

*  ls_layo-colwidth_optimize = 'X'.
  lv_repid = sy-repid.

  CALL FUNCTION 'REUSE_ALV_LIST_DISPLAY'
    EXPORTING
*     I_INTERFACE_CHECK  = ' '
*     I_BYPASSING_BUFFER =
*     I_BUFFER_ACTIVE    = ' '
      i_callback_program = lv_repid
      is_layout          = ls_layo
      it_fieldcat        = lt_fcat
*     I_DEFAULT          = 'X'
      i_save             = 'X'
      is_variant         = variant_out
    TABLES
      t_outtab           = gt_out
    EXCEPTIONS
      program_error      = 1
      OTHERS             = 2.
  IF sy-subrc <> 0.
  ENDIF.


ENDFORM.                    " display

          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_12 ).

        APPEND ls_record_12 TO gt_record_12.

      WHEN '13'.

        DATA ls_record_13 TYPE ty_record_13.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_13 ).

        APPEND ls_record_13 TO gt_record_13.

      WHEN '15'.

        DATA ls_record_15 TYPE ty_record_15.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_15 ).

        APPEND ls_record_15 TO gt_record_15.

      WHEN '21'.

        DATA ls_record_21 TYPE ty_record_21.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_21 ).

        APPEND ls_record_21 TO gt_record_21.

      WHEN '22'.

        DATA ls_record_22 TYPE ty_record_22.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_22 ).

        APPEND ls_record_22 TO gt_record_22.

      WHEN '41'.

        DATA ls_record_41 TYPE ty_record_41.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_41 ).

        APPEND ls_record_41 TO gt_record_41.

      WHEN '42'.


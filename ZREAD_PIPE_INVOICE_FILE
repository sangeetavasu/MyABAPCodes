*---------------------------------------------------------------------*
* Generic parsing class
*---------------------------------------------------------------------*
CLASS lcl_file_parser DEFINITION FINAL.

  PUBLIC SECTION.

    CLASS-METHODS:
      split_line
        IMPORTING
          iv_line        TYPE string
        EXPORTING
          ev_record_type TYPE string
          et_fields      TYPE tt_string,

      move_to_structure
        IMPORTING
          it_fields TYPE tt_string
        CHANGING
          cs_record TYPE any.

ENDCLASS.                    "lcl_file_parser DEFINITION

*----------------------------------------------------------------------*
*       CLASS lcl_file_parser IMPLEMENTATION
*----------------------------------------------------------------------*
*
*----------------------------------------------------------------------*
CLASS lcl_file_parser IMPLEMENTATION.

  METHOD split_line.

    CLEAR:
      ev_record_type,
      et_fields.

    SPLIT iv_line AT '|' INTO TABLE et_fields.

    READ TABLE et_fields
      INDEX 1
      INTO ev_record_type.

  ENDMETHOD.                    "split_line

  METHOD move_to_structure.
    DATA: lv_value LIKE LINE OF it_fields.
    FIELD-SYMBOLS:
      <lv_component> TYPE ANY.

    CLEAR cs_record.

    LOOP AT it_fields INTO lv_value.

      ASSIGN COMPONENT sy-tabix
        OF STRUCTURE cs_record
        TO <lv_component>.

      IF sy-subrc <> 0.
        EXIT.
      ENDIF.

      <lv_component> = lv_value.

    ENDLOOP.

  ENDMETHOD.                    "move_to_structure

ENDCLASS.                    "lcl_file_parser IMPLEMENTATION

*---------------------------------------------------------------------*
* File selection help
*---------------------------------------------------------------------*
AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_file.

  DATA:
    lt_file_table TYPE filetable,
    ls_selected_file LIKE LINE OF lt_file_table,
    lv_rc         TYPE i.

  cl_gui_frontend_services=>file_open_dialog(
    EXPORTING
      window_title      = 'Select pipe-delimited invoice file'
      default_extension = 'txt'
      file_filter       = 'Text files (*.txt)|*.txt|All files (*.*)|*.*|'
    CHANGING
      file_table        = lt_file_table
      rc                = lv_rc
    EXCEPTIONS
      OTHERS            = 1 ).

  IF sy-subrc = 0 AND lv_rc > 0.

    READ TABLE lt_file_table INDEX 1 INTO  ls_selected_file .
    IF sy-subrc = 0.
      p_file = ls_selected_file-filename.
    ENDIF.
  ENDIF.

*RADIO BUTTON TOGGLE

AT SELECTION-SCREEN OUTPUT.
  LOOP AT SCREEN.
    IF p_rad1 = 'X'.
      IF screen-group1 = 'M2'.
        screen-input = 0. " Disable second field
      ELSE.
        screen-input = 1. " Enable first field
      ENDIF.
    ELSEIF p_rad2 = 'X'.
      IF screen-group1 = 'M1'.
        screen-input = 0. " Disable first field
      ELSE.
        screen-input = 1. " Enable second field
      ENDIF.
    ENDIF.
    MODIFY SCREEN.
  ENDLOOP.

*---------------------------------------------------------------------*
* Main processing
*---------------------------------------------------------------------*
START-OF-SELECTION.

  IF p_rad1 IS NOT INITIAL.

    PERFORM upload_file.
    PERFORM parse_file.
    PERFORM create_idocs.
    PERFORM display_summary.

  ELSEIF p_rad2 IS NOT INITIAL.
    PERFORM read_directory.
    IF gt_filedir IS NOT INITIAL.
      LOOP AT gt_filedir INTO gs_filedir.
        PERFORM upload_file.
        PERFORM parse_file.
        PERFORM create_idocs.
      ENDLOOP.
      PERFORM display_summary.
    ENDIF.
  ENDIF.

*---------------------------------------------------------------------*
* Upload frontend file
*---------------------------------------------------------------------*
FORM upload_file.

  DATA: lv_filename TYPE string,
        ls_created_file  TYPE ty_created_idoc.
  CLEAR: ls_created_file.

  IF p_rad1 IS NOT INITIAL.
    lv_filename = p_file.
  ELSEIF p_rad2 IS NOT INITIAL.
    CONCATENATE p_dir gt_filedir-name INTO lv_filename.
  ENDIF.

  cl_gui_frontend_services=>gui_upload(
    EXPORTING
      filename                = lv_filename
      filetype                = 'ASC'
      has_field_separator     = abap_false
    CHANGING
      data_tab                = gt_file_lines
    EXCEPTIONS
      file_open_error         = 1
      file_read_error         = 2
      no_batch                = 3
      gui_refuse_filetransfer = 4
      invalid_type            = 5
      no_authority            = 6
      unknown_error           = 7
      bad_data_format         = 8
      header_not_allowed      = 9
      separator_not_allowed   = 10
      header_too_long         = 11
      unknown_dp_error        = 12
      access_denied           = 13
      dp_out_of_memory        = 14
      disk_full               = 15
      dp_timeout              = 16
      not_supported_by_gui    = 17
      error_no_gui            = 18
      OTHERS                  = 19 ).

  IF sy-subrc <> 0.
*    MESSAGE | unable to upload file. return code: { sy-subrc }|
*      type 'E'.
  ENDIF.

  ls_created_file-mescod = 'FIL'.
  ls_created_file-file = lv_filename.
  gv_fileno = gv_fileno + 1.
  ls_created_file-fileno = gv_fileno.
  APPEND ls_created_file TO gt_created_idocs.

ENDFORM.                    "upload_file

*---------------------------------------------------------------------*
* Parse file into record-specific internal tables
*---------------------------------------------------------------------*
FORM parse_file.

  DATA:
    lt_fields     TYPE tt_string,
    lv_record_type TYPE string,
    lv_line LIKE LINE OF gt_file_lines,
    lv_line_number LIKE sy-tabix.

  LOOP AT gt_file_lines INTO lv_line.

    lv_line_number = sy-tabix.

    IF lv_line IS INITIAL.
      CONTINUE.
    ENDIF.

    lcl_file_parser=>split_line(
      EXPORTING
        iv_line        = lv_line
      IMPORTING
        ev_record_type = lv_record_type
        et_fields      = lt_fields ).

    CASE lv_record_type.

      WHEN '01'.

        DATA ls_record_01 TYPE ty_record_01.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_01 ).

        APPEND ls_record_01 TO gt_record_01.

      WHEN '02'.

        DATA ls_record_02 TYPE ty_record_02.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_02 ).

        APPEND ls_record_02 TO gt_record_02.

      WHEN '05'.

        DATA ls_record_05 TYPE ty_record_05.

        lcl_file_parser=>move_to_structure(
          EXPORTING
            it_fields = lt_fields
          CHANGING
            cs_record = ls_record_05 ).

        APPEND ls_record_05 TO gt_record_05.

      WHEN '06'.


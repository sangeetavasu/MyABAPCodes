        APPEND ls_record_42 TO gt_record_42.

      WHEN OTHERS.

*        APPEND value #(
*          line_number = lv_line_number
*          record_type = lv_record_type
*          message     = 'Unknown record type'
*          raw_line    = lv_line
*        ) TO gt_errors.

    ENDCASE.

    CLEAR:
      lt_fields,
      lv_record_type.

  ENDLOOP.

ENDFORM.                    "parse_file

*---------------------------------------------------------------------*
* Display parsing summary
*---------------------------------------------------------------------*
FORM display_summary.
  DATA: ls_created_idoc  TYPE ty_created_idoc,
        ls_created_file  TYPE ty_created_idoc.

  WRITE: / 'File Processing Completed'.

  LOOP AT gt_created_idocs INTO ls_created_file WHERE mescod = 'FIL'.
    WRITE: / 'File Name:'.
    WRITE: / ls_created_file-file.
    SKIP 1.
    WRITE: / 'Non-PO Invoice IDocs:'.
    LOOP AT gt_created_idocs INTO ls_created_idoc WHERE mescod = 'FI'
      AND fileno = ls_created_file-fileno.
      WRITE: / ls_created_idoc-docnum.
    ENDLOOP.
    SKIP 1.
    WRITE: / 'PO Invoice IDocs:'.
    LOOP AT gt_created_idocs INTO ls_created_idoc WHERE mescod = 'MM'
      AND fileno = ls_created_file-fileno.
      WRITE: / ls_created_idoc-docnum.
    ENDLOOP.
  ENDLOOP.
*         '------------------------------------------',
*         /  'record type 01: { lines( gt_record_01 ) }',
*         / |record type 02: { lines( gt_record_02 ) }|,
*         / |record type 05: { lines( gt_record_05 ) }|,
*         / |record type 06: { lines( gt_record_06 ) }|,
*         / |record type 11: { lines( gt_record_11 ) }|,
*         / |record type 12: { lines( gt_record_12 ) }|,
*         / |record type 13: { lines( gt_record_13 ) }|,
*         / |record type 15: { lines( gt_record_15 ) }|,
*         / |record type 21: { lines( gt_record_21 ) }|,
*         / |record type 22: { lines( gt_record_22 ) }|,
*         / |record type 41: { lines( gt_record_41 ) }|,
*         / |record type 42: { lines( gt_record_42 ) }|,
*         / |errors:         { lines( gt_errors ) }|.

  IF gt_errors IS NOT INITIAL.

    SKIP 2.
    WRITE: / 'Errors',
           / '------------------------------------------'.

*    LOOP AT gt_errors INTO data(ls_error).
*      WRITE:
**        / |line { ls_error-line_number }:|,
*          ls_error-record_type,
*          ls_error-message.
*    ENDLOOP.

  ENDIF.

ENDFORM.                    "display_summary
*---------------------------------------------------------------------*
* Create INVOIC IDocs
*---------------------------------------------------------------------*
FORM create_idocs.
  DATA: ls_record_01 TYPE ty_record_01,
        ls_record_21  TYPE ty_record_21,
        ls_record_42  TYPE ty_record_42.

* IDoc data segments
  DATA: ls_edidc    TYPE edi_dc40,
        lt_edidc    TYPE TABLE OF edi_dc40,
        ls_edidd    TYPE edi_dd40,
        lt_edidd    TYPE TABLE OF edi_dd40,
        ls_e1edk01  TYPE e1edk01,
        ls_e1edka1  TYPE e1edka1,
        ls_e1edk02  TYPE e1edk02,
        ls_e1edk03  TYPE e1edk03,
        ls_e1edk14  TYPE e1edk14,
        ls_e1edp01  TYPE e1edp01,
        ls_e1edp02  TYPE e1edp02,
        ls_e1edp19  TYPE e1edp19,
        ls_e1edp26  TYPE e1edp26,
        ls_e1eds01  TYPE e1eds01,
        ls_e1edk04  TYPE e1edk04,
        ls_e1edp04  TYPE e1edp04,
        lv_edidc_docnum TYPE edidc-docnum,
        lv_year(4)  TYPE c,
        lv_month(2) TYPE c,
        lv_day(2)   TYPE c,
        lv_ebelp   TYPE ekpo-ebelp.
  DATA: ls_created_idoc TYPE ty_created_idoc.

  LOOP AT gt_record_01 INTO ls_record_01.
    CLEAR: ls_edidc, ls_edidd, ls_e1edk01, ls_e1edka1, ls_e1edk02,
           ls_e1edk03, ls_e1edk14, ls_e1edp01, ls_e1edp02, ls_e1edp19,
           ls_e1edp26, ls_e1eds01, ls_e1edk04, ls_e1edp04.

    CASE ls_record_01-invoice_type.
      WHEN 'Non-PO'.  "FB60 invoice
*control record
        ls_edidc-idoctyp = 'INVOIC02'.
        ls_edidc-mestyp = 'INVOIC'.
        ls_edidc-mescod = 'FI'.
        CONCATENATE 'SAP' sy-sysid INTO ls_edidc-rcvpor.
        ls_edidc-rcvprt = 'LS'.
        ls_edidc-rcvpfc = 'LS'.
        CONCATENATE sy-sysid 'CLNT' sy-mandt INTO ls_edidc-rcvprn.
        ls_edidc-sndpor = 'ONPHASE'.
        ls_edidc-sndprt = 'LS'.
        ls_edidc-sndpfc = 'LS'.
        ls_edidc-sndprn = 'ONPHASE'.
*header
        ls_e1edk01-curcy  = ls_record_01-currency.
        ls_e1edk01-bsart  = 'INVO'.
        ls_edidd-segnam   = 'E1EDK01'.
        ls_edidd-sdata    = ls_e1edk01.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edka1-parvw  = 'LF'.
        ls_e1edka1-partn  = ls_record_01-supplier_number.
        ls_edidd-segnam   = 'E1EDKA1'.
        ls_edidd-sdata    = ls_e1edka1.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk02-qualf  = '009'.
        ls_e1edk02-belnr  = ls_record_01-invoice_number.
        ls_edidd-segnam   = 'E1EDK02'.
        ls_edidd-sdata    = ls_e1edk02.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk03-iddat  = '012'.
        CLEAR: lv_year, lv_month, lv_day.
        lv_year   = ls_record_01-invoice_date+0(4).
        lv_month  = ls_record_01-invoice_date+5(2).
        lv_day    = ls_record_01-invoice_date+8(2).
        CONCATENATE lv_year lv_month lv_day INTO ls_e1edk03-datum.
        ls_edidd-segnam   = 'E1EDK03'.
        ls_edidd-sdata    = ls_e1edk03.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk04-mwskz = 'XX'.  "FIX THIS - need determination logic
        ls_e1edk04-mwsbt = ls_record_01-tax_amount.
        ls_edidd-segnam   = 'E1EDK04'.
        ls_edidd-sdata    = ls_e1edk04.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk14-qualf  = '011'.
        ls_e1edk14-orgid  = '3000'.
        ls_edidd-segnam   = 'E1EDK14'.
        ls_edidd-sdata    = ls_e1edk14.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.
*line items
        LOOP AT gt_record_21 INTO ls_record_21 WHERE invoice_id = ls_record_01-invoice_id.
          CLEAR: ls_e1edp01, ls_e1edp02, ls_e1edp19, ls_e1edp26, ls_e1edp04.

          ls_e1edp01-posex  = ls_record_21-item_number.
          ls_edidd-segnam   = 'E1EDP01'.
          ls_edidd-sdata    = ls_e1edp01.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp02-qualf = '021'.
          READ TABLE gt_record_42 INTO ls_record_42 WITH KEY segment_no = '2'.
          IF sy-subrc = 0.
            ls_e1edp02-belnr = ls_record_42-segment_value. "cost center - TBD
          ENDIF.
          ls_edidd-segnam   = 'E1EDP02'.
          ls_edidd-sdata    = ls_e1edp02.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp19-qualf = '002'.
          READ TABLE gt_record_42 INTO ls_record_42 WITH KEY segment_no = '1'.
          IF sy-subrc = 0.
            ls_e1edp19-idtnr = ls_record_42-segment_value. "cost center - TBD
          ENDIF.
          ls_edidd-segnam   = 'E1EDP19'.
          ls_edidd-sdata    = ls_e1edp19.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp26-qualf = '002'.
          ls_e1edp26-betrg = ls_record_21-line_amount.
          ls_edidd-segnam   = 'E1EDP26'.
          ls_edidd-sdata    = ls_e1edp26.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp04-mwskz = 'XX'.
          ls_edidd-segnam   = 'E1EDP04'.
          ls_edidd-sdata    = ls_e1edp04.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

        ENDLOOP.
*summary
        ls_e1eds01-sumid = '011'.
        ls_e1eds01-summe = ls_record_01-invoice_amount.
        ls_edidd-segnam   = 'E1EDS01'.
        ls_edidd-sdata    = ls_e1eds01.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

      WHEN 'PO'. "MIRO invoice
*control record
        ls_edidc-idoctyp = 'INVOIC02'.
        ls_edidc-mestyp = 'INVOIC'.
        ls_edidc-mescod = 'MM'.
        CONCATENATE 'SAP' sy-sysid INTO ls_edidc-rcvpor.
        ls_edidc-rcvprt = 'LS'.
        ls_edidc-rcvpfc = 'LS'.
        CONCATENATE sy-sysid 'CLNT' sy-mandt INTO ls_edidc-rcvprn.
        ls_edidc-sndpor = 'ONPHASE'.
        ls_edidc-sndprt = 'LS'.
        ls_edidc-sndpfc = 'LS'.
        ls_edidc-sndprn = 'ONPHASE'.
*header
        ls_e1edk01-curcy  = ls_record_01-currency.
        ls_e1edk01-bsart  = 'INVO'.
        ls_edidd-segnam   = 'E1EDK01'.
        ls_edidd-sdata    = ls_e1edk01.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edka1-parvw  = 'LF'. "vendor
        ls_e1edka1-partn  = ls_record_01-supplier_number.
        ls_edidd-segnam   = 'E1EDKA1'.
        ls_edidd-sdata    = ls_e1edka1.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk02-qualf  = '009'.  "invoice number
        ls_e1edk02-belnr  = ls_record_01-invoice_number.
        ls_edidd-segnam   = 'E1EDK02'.
        ls_edidd-sdata    = ls_e1edk02.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk03-iddat  = '012'.  "document date
        CLEAR: lv_year, lv_month, lv_day.
        lv_year   = ls_record_01-invoice_date+0(4).
        lv_month  = ls_record_01-invoice_date+5(2).
        lv_day    = ls_record_01-invoice_date+8(2).
        CONCATENATE lv_year lv_month lv_day INTO ls_e1edk03-datum.
        ls_edidd-segnam   = 'E1EDK03'.
        ls_edidd-sdata    = ls_e1edk03.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk04-mwskz = 'XX'.  "FIX THIS - need determination logic
        ls_e1edk04-mwsbt = ls_record_01-tax_amount.
        ls_edidd-segnam   = 'E1EDK04'.
        ls_edidd-sdata    = ls_e1edk04.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.

        ls_e1edk14-qualf  = '011'.  "company code
        ls_e1edk14-orgid  = '3000'.
        ls_edidd-segnam   = 'E1EDK14'.
        ls_edidd-sdata    = ls_e1edk14.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.
*line items
        LOOP AT gt_record_21 INTO ls_record_21 WHERE invoice_id = ls_record_01-invoice_id.
          CLEAR: ls_e1edp01, ls_e1edp02, ls_e1edp19, ls_e1edp26, lv_ebelp, ls_e1edp04.

          IF ls_record_21-field_05 IS NOT INITIAL.
            lv_ebelp = ls_record_21-field_05.
            CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT' "add leading zeros
              EXPORTING
                input         = lv_ebelp
             IMPORTING
               output        = lv_ebelp.
            ls_e1edp01-posex  = lv_ebelp.
          ENDIF.
          ls_e1edp01-menge  = ls_record_21-quantity.
          ls_e1edp01-menee  = ls_record_21-unit_of_measure.
          ls_edidd-segnam   = 'E1EDP01'.
          ls_edidd-sdata    = ls_e1edp01.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp02-qualf = '001'.
          IF ls_record_21-field_04 IS NOT INITIAL.
            ls_e1edp02-belnr = ls_record_21-field_04. "PO reference - line specifc
          ELSE.
            ls_e1edp02-belnr = ls_record_01-field_07. "PO reference - whole invoice
          ENDIF.
          ls_e1edp02-zeile  = lv_ebelp.  "PO line reference
          ls_edidd-segnam   = 'E1EDP02'.
          ls_edidd-sdata    = ls_e1edp02.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp26-qualf = '002'. "line amount
          ls_e1edp26-betrg = ls_record_21-line_amount.
          ls_edidd-segnam   = 'E1EDP26'.
          ls_edidd-sdata    = ls_e1edp26.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

          ls_e1edp04-mwskz = 'XX'.
          ls_edidd-segnam   = 'E1EDP04'.
          ls_edidd-sdata    = ls_e1edp04.
          APPEND ls_edidd TO lt_edidd.
          CLEAR ls_edidd.

        ENDLOOP.
*summary
        ls_e1eds01-sumid = '011'. "invoice total
        ls_e1eds01-summe = ls_record_01-invoice_amount.
        ls_edidd-segnam   = 'E1EDS01'.
        ls_edidd-sdata    = ls_e1eds01.
        APPEND ls_edidd TO lt_edidd.
        CLEAR ls_edidd.
    ENDCASE.

*generate IDoc and process
    CALL FUNCTION 'IDOC_INBOUND_SINGLE'
      EXPORTING
        pi_idoc_control_rec_40  = ls_edidc
        pi_do_commit            = 'X'
      IMPORTING
        pe_idoc_number          = lv_edidc_docnum
      TABLES
        pt_idoc_data_records_40 = lt_edidd
      EXCEPTIONS
        idoc_not_saved          = 1
        OTHERS                  = 2.

    ls_edidc-docnum = lv_edidc_docnum.
    APPEND ls_edidc TO lt_edidc.
  ENDLOOP.

  LOOP AT lt_edidc  INTO ls_edidc.
    ls_created_idoc-docnum = ls_edidc-docnum.
    ls_created_idoc-mescod = ls_edidc-mescod.
    ls_created_idoc-fileno = gv_fileno.
    APPEND ls_created_idoc TO gt_created_idocs.

  ENDLOOP.

ENDFORM.                    "create_idocs
*&---------------------------------------------------------------------*
*&      Form  read_directory
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM read_directory.

  MOVE p_dir TO gv_dirname.
  CLEAR: gt_filedir[].
  CALL FUNCTION 'EPS_GET_DIRECTORY_LISTING'
    EXPORTING
      dir_name               = gv_dirname
    IMPORTING
      dir_name               = gv_dir_retrn
      file_counter           = gv_nbr_files
      error_counter          = gv_nbr_errs
    TABLES
      dir_list               = gt_filedir
    EXCEPTIONS
      invalid_eps_subdir     = 1
      sapgparam_failed       = 2
      build_directory_failed = 3
      no_authorization       = 4
      read_directory_failed  = 5
      too_many_read_errors   = 6
      empty_directory_list   = 7
      OTHERS                 = 8.
  CASE sy-subrc.
*   "everything is OK
    WHEN 0.
    WHEN 1 OR 2 OR 3.
      WRITE: / 'Internal SAP error reading directory', AT 39 gv_dirname.
*      MESSAGE i000 WITH 'Internal SAP error reading directory' gv_dirname.
    WHEN 4.
      WRITE: / 'No authorization to read directory', AT 37 gv_dirname.
*      MESSAGE i000 WITH 'No authorization to read directory' gv_dirname.
    WHEN 5 OR 6 OR 8.
      WRITE: / 'Errors reading directory', AT 27 gv_dirname.
*      MESSAGE i000 WITH 'Errors reading directory' gv_dirname.
  ENDCASE.


ENDFORM.                    "read_directory

managed implementation in class zbp_r5092_travel unique;
strict ( 2 );

define behavior for ZR5092_TRAVEL alias travel
persistent table z5092_travel
lock master
authorization master ( instance )
etag master ChangedAt

{
  create ( authorization : global );
  update;
  delete;
  field ( readonly :update,  mandatory : create ) AgencyId, TravelId;
  field ( mandatory ) Description, CustomerID, BeginDate, EndDate;
  field (readonly ) ChangedAt, Status, ChangedBy;

  action approve_travel result [0..1] $self;
  action cancel_travel result [0..1] $self;

mapping for z5092_travel corresponding
    {
      AgencyID    = agency_id;
      TravelID    = travel_id;
      CustomerID  = customer_id;
      BeginDate   = begin_date;
      EndDate     = end_date;
      ChangedAt   = changed_at;
      ChangedBy   = changed_by;
    }

    }
@Metadata.layer: #CORE
@Search.searchable: true
@UI: {
   headerInfo: {
     typeName: 'Flight Travel',
     typeNamePlural: 'Flight Travels',
     title:          { value: 'Description'},
     description:    { value: 'Description' }
               }
     }
annotate entity ZC5092_TRAVEL with
{

  @UI.facet: [ { id:            'Travel',
                      purpose:       #STANDARD,
                      type:          #IDENTIFICATION_REFERENCE,
                      label:         'Travel',
                      position:      10 }
                 ]

  @UI.lineItem: [{ position : 10  }]
  @UI.selectionField: [ { position: 10  }]
  @UI.identification: [ { position: 10, importance: #HIGH } ]
  AgencyId;
  @UI.lineItem: [{ position : 20  }]
  @UI.identification: [ { position: 20, importance: #HIGH } ]
  @UI.selectionField: [ { position: 20  }]
 @Search.defaultSearchElement: true
@Search.fuzzinessThreshold: 0.8
  TravelId;
  @UI: {
          lineItem:       [ { position: 30, importance: #HIGH } ],
          identification: [ { position: 30, importance: #HIGH } ]
        }
  Description;
  @UI: {
          lineItem:       [ { position: 40, importance: #MEDIUM } ],
          identification: [ { position: 40, importance: #MEDIUM } ],
          selectionField: [ { position: 30 }]
        }
  CustomerId;
   @UI: {
           lineItem:       [ { position: 50, importance: #MEDIUM } ],
           identification: [ { position: 50, importance: #MEDIUM } ]
         }
  BeginDate;
 @UI: {
           lineItem:       [ { position: 60, importance: #LOW } ],
           identification: [ { position: 60, importance: #LOW } ]
         }
  EndDate;
      @UI: {
           lineItem:       [ { position: 70, importance: #HIGH },
                             {type:       #FOR_ACTION, dataAction: 'approve_travel', label: 'Approve the Travel' } ,
                             {type:       #FOR_ACTION, dataAction: 'cancel_travel', label: 'Reject the Travel' } ],
           identification: [ { position: 70, importance: #HIGH } ]
         }
 
  Status;
  @UI.hidden: true
  ChangedAt;
   @UI.hidden: true
  ChangedBy;
     @UI.hidden: true
 CustomerName;
  

}
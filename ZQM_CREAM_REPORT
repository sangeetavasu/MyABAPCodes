        column->set_long_text( 'MilkSolidNonFat' ).
        column->set_output_length( '15' ).
      CATCH cx_salv_not_found.
    ENDTRY.

    TRY.
        column = gr_columns->get_column( 'COMMENTS' ).
        column->set_short_text( 'Comments' ).
